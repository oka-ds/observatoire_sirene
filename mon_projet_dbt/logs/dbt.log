  create view "observatoire_sirene"."observatoire_observatoire"."stg_periodes__dbt_tmp"
    
    
  as (
    WITH source AS (

    SELECT

        CAST(siret AS VARCHAR) AS siret,

        CAST(dateDebut AS DATE) AS date_debut,

        CASE

            WHEN etatAdministratifEtablissement = 'A'
            THEN 'A'

            WHEN etatAdministratifEtablissement = 'F'
            THEN 'F'

            ELSE NULL

        END AS etat,


        CAST(codeCommuneEtablissement AS VARCHAR)
        AS code_commune,


        UPPER(
            libelleCommuneEtablissement
        )
        AS libelle_commune,


        CAST(
            activitePrincipaleEtablissement
            AS VARCHAR
        )
        AS code_ape,


        CAST(
            trancheEffectifsEtablissement
            AS VARCHAR
        )
        AS code_tranche



    FROM "observatoire_sirene"."public"."sirene_etablissement"


)


SELECT *

FROM source

WHERE siret IS NOT NULL

AND date_debut IS NOT NULL
  );
