        COALESCE(
            CAST("nomenclatureActivitePrincipaleEtablissement" AS VARCHAR),
            'INCONNU'
        ) AS nomenclature_ape,


        COALESCE(
            CAST("codeCommuneEtablissement" AS VARCHAR(5)),
            '99999'
        ) AS code_commune,


        COALESCE(
            UPPER("libelleCommuneEtablissement"),
            'INCONNU'
